# Only needed when the backend is hosted at a different address than this app (for example on Vercel).
# Set it in the Vercel project settings (Environment Variables), then redeploy. No trailing slash.
# VITE_API_BASE=https://executive-360-demo-backend.vercel.app

# Demo login (required). Vite bundles VITE_ values into the public JS, so this is a simple gate, not real security.
# Put the real values in frontend/.env (git-ignored) locally, and in the Vercel project's Environment Variables.
VITE_LOGIN_USER=admin
VITE_LOGIN_PASSWORD=change-me
